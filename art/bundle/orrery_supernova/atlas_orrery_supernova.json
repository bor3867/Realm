 "event_horizon_sequence": [
  "0.0s  Boss invulnerable. Play p3_to_p4 at 6fps (2.0s). Music cuts to a low drone.",
  "0.0-1.0s  (frames 0-5) The hole swells. Pull every player toward the centre (1.5 tiles/s). Spawn debris_marble / debris_brass particles on the floor and spiral them into the boss.",
  "0.0-1.0s  void_creep spreads from the arena walls to the centre (ring by ring, frames 0->3 per tile). Wall tiles go dark. Vignette the screen edges.",
  "1.0-1.3s  (frames 6-7) Everything black except the boss; the pull stops.",
  "1.3s  (frame 8) Detonation: full-screen white flash (0.15s), screen shake, 1 knockback ring that pushes players 3 tiles out.",
  "1.3-2.0s  (frames 9-11) The nova unfolds. The floor stays void (use astral_void tiles); the arena is now a starfield.",
  "2.0s  Phase 4 starts (p4_idle). Boss gains 'Supernova' name plate."
 ],
 "phase4_cycle": [
  "Spiral Storm (4s): nova_spiral from 4 arms, 6 volleys/s, arms rotate 11 deg per volley, reversing each cycle. helix_pair in 8 directions every 0.8s.",
  "Planetfall (3s): planet_chunk bursts of 10 every 0.6s, cycling ice/rock/violet; violet chunks split into embers.",
  "Comet Wheel (3s): 6 plasma_comets curving clockwise + stellar_ember rings of 24.",
  "Gamma Burst (3s): the polar jets telegraph 1s, then gamma_ray beams sweep 90 deg; 2 singularity_seeds drift in.",
  "Every cycle ends with p4_attack: release fires a shock_arc ring (36, two gaps)."
 ]
}