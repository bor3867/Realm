  "info": {
   "nova_spiral": "Spiral-arm star. Fired from 4 arms that rotate 11 deg per volley, 6 volleys/s for 3s; arms reverse every cycle.",
   "planet_chunk_ice": "Shattered-planet chunk. Radial bursts of 10, alternating colour per burst; chunks slow down then hang for 0.5s.",
   "planet_chunk_rock": "As planet_chunk_ice; heavier (slower, bigger hitbox, more damage).",
   "planet_chunk_violet": "As planet_chunk_ice; splits into 3 stellar_embers when it stops.",
   "plasma_comet": "Big curving comet. 6 at once, each curving clockwise (angular velocity 60 deg/s), leaving an ember every 0.2s.",
   "gamma_ray": "Beam segment; chain 12 end to end for a gamma burst out of a jet that sweeps 90 deg over 2s (telegraph 1s).",
   "helix_pair": "Twin braided orbs on one path. 8 directions, rotating; the two orbs have separate hitboxes.",
   "shock_arc": "Nova shock ring slice. Fire 36 as an expanding ring with 2 gaps (aimed gap + random gap) on every p4_attack release.",
   "stellar_ember": "Filler ember. Dense slow rings of 24 between patterns; dropped by comets and violet chunks.",
   "singularity_seed": "Small black hole. 2 per cycle, slow homing; pulls players gently within 2 tiles."
  }
 },
